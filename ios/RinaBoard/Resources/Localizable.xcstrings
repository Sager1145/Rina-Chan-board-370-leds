    "灵敏度 %.0f dB" : {
      "comment" : "lip sync microphone threshold",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensitivity %.0f dB"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感度 %.0f dB"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靈敏度 %.0f dB"
          }
        }
      }
    },
    "灵敏度是判定为静音的音量下限；防抖帧数取最近若干次识别结果的众数，1 表示不防抖。切换识别模型会重置校准。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensitivity is the level below which a window counts as silence. Smoothing takes the most common result of the last few frames; 1 disables it. Switching the voice model resets calibration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感度は、無音と判定する音量の下限です。スムージングは直近数フレームの認識結果の最頻値をとり、1 でスムージングなしになります。音声モデルを切り替えると、キャリブレーションはリセットされます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靈敏度是判定為靜音的音量下限；防抖影格數取最近數次辨識結果的眾數，1 表示不防抖。切換辨識模型會重置校準。"
          }
        }
      }
    },
