    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to connect to the board over Bluetooth"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth で璃奈ちゃんボードに接続するために使用します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于通过蓝牙连接璃奈板"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於透過藍牙連線璃奈板"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to find and connect to the board on your local network or hotspot"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワークやホットスポット上で璃奈ちゃんボードを検出して接続するために使用します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在局域网/热点中发现并连接璃奈板"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在區域網路／熱點中尋找並連線璃奈板"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt used only when the user asks to read the current Wi-Fi name",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only when you tap Read to show the name of the Wi-Fi network your iPhone is using"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「読み取る」をタップしたときだけ、iPhone が使用中の Wi-Fi 名を表示するために使用します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你点按读取时，用于显示 iPhone 当前连接的 Wi-Fi 名称"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你點一下讀取時，才會用於顯示 iPhone 目前連線的 Wi-Fi 名稱"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for lip sync: your vowels are detected live and drive the board's mouth"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リップシンクに使用します。話した母音をリアルタイムで認識し、璃奈ちゃんボードの口を動かします"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于口型同步：实时识别你的元音并驱动璃奈板的嘴型"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於嘴型同步：即時辨識你的母音並驅動璃奈板的嘴型"
          }
        }
      }
    },
    "ReadCurrentWiFiSSID" : {
      "comment" : "Temporary full-accuracy purpose string for reading the current Wi-Fi SSID",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise Location allows the system to provide the current Wi-Fi name to this app"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「正確な位置情報」を許可すると、現在の Wi-Fi 名をシステムからこの App に提供できます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确位置权限让系统向本 App 提供当前 Wi-Fi 名称"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精確位置權限可讓系統向此 App 提供目前的 Wi-Fi 名稱"
          }
        }
      }
    }
  },
  "version" : "1.0"
