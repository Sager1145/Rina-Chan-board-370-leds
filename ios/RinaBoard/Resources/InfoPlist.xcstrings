    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to connect to the board over Bluetooth"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth で璃奈ちゃんボードに接続するために使用します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于通过蓝牙连接璃奈板"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於透過藍牙連線璃奈板"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to find and connect to the board on your local network or hotspot"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワークやホットスポット上で璃奈ちゃんボードを検出して接続するために使用します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在局域网/热点中发现并连接璃奈板"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在區域網路／熱點中尋找並連線璃奈板"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission protects Wi-Fi names; requested only for reading Wi-Fi or joining a board hotspot on Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only when you read the current Wi-Fi name or connect to a board hotspot. Wi-Fi names require location permission."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の Wi-Fi 名を読み取るとき、またはボードのホットスポットに接続するときだけ使用します。Wi-Fi 名の取得には位置情報の許可が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你读取 Wi-Fi 或连接璃奈板热点时，用于确认当前 Wi-Fi 名称"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在你讀取 Wi-Fi 或連接璃奈板熱點時，用於確認目前 Wi-Fi 名稱"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for lip sync: your vowels are detected live and drive the board's mouth"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リップシンクに使用します。話した母音をリアルタイムで認識し、璃奈ちゃんボードの口を動かします"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于口型同步：实时识别你的元音并驱动璃奈板的口型"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於嘴型同步：即時辨識你的母音並驅動璃奈板的嘴型"
          }
        }
      }
    },
    "ReadCurrentWiFiSSID" : {
      "comment" : "Temporary full-accuracy purpose string for reading the current Wi-Fi SSID",
