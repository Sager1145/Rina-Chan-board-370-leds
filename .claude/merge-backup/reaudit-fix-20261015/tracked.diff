+    if (serializeJson(doc, snapshot, bytes + 1) != bytes) {
+        free(snapshot);
+        error = "incomplete saved faces snapshot";
+        return false;
+    }
+    g_facesReadSnapshot = snapshot;
+    g_facesReadSnapshotBytes = bytes;
+    g_facesReadSnapshotGen = generation;
+    return true;
